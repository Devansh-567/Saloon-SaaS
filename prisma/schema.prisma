generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  RECEPTIONIST
  STAFF
}

enum SalonStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  SERVING
  DONE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  REFUNDED
  OVERDUE
  VOID
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK
  OTHER
}

enum ExpenseStatus {
  RECORDED
  VOID
}

enum StockMovementType {
  PURCHASE
  SALE
  USAGE
  ADJUSTMENT
  RETURN
  WASTAGE
}

enum FileKind {
  LOGO
  INVOICE
  RECEIPT
  DOCUMENT
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  ACCEPTED
  FAILED
  SKIPPED
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  LEAVE
  HOLIDAY
  WEEK_OFF
}

enum LeaveType {
  CASUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PayrollStatus {
  PENDING
  PAID
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}

enum EmployeeDocumentKind {
  AADHAAR
  PAN
  PHOTO
  CONTRACT
  OTHER
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  passwordHash     String
  name             String
  phone            String?
  platformRole     PlatformRole @default(USER)
  mfaSecret        String?
  mfaEnabled       Boolean      @default(false)
  mfaRecoveryCodes String[]     @default([])
  mustChangePassword Boolean    @default(false)
  failedAttempts   Int          @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  ownedSalons      Salon[]      @relation("SalonOwner")
  memberships      Membership[]
  sessions         Session[]
  passwordResets   PasswordResetToken[]
  invitesSent     Invitation[] @relation("InvitedBy")
  auditLogs        AuditLog[]
  uploadedFiles    FileAsset[]
  notifications    NotificationLog[]
  createdAppointments Appointment[] @relation("AppointmentCreator")
  createdInvoices  Invoice[]    @relation("InvoiceCreator")
  receivedPayments Payment[]    @relation("PaymentReceiver")
  createdExpenses  Expense[]    @relation("ExpenseCreator")
  stockMovements   StockMovement[] @relation("StockActor")
  purchases        Purchase[]   @relation("PurchaseCreator")
  attendanceMarked AttendanceRecord[] @relation("AttendanceMarker")
  leaveDecisions   LeaveRequest[] @relation("LeaveDecider")
  advanceDecisions SalaryAdvance[] @relation("AdvanceDecider")
  advancesCreated  SalaryAdvance[] @relation("AdvanceCreator")
  salariesCreated  SalaryPayment[] @relation("SalaryCreator")
  employeeDocumentsUploaded EmployeeDocument[] @relation("EmployeeDocUploader")
  customerNotes    CustomerNote[] @relation("CustomerNoteAuthor")
  customerFollowUps CustomerFollowUp[] @relation("FollowUpCreator")
  rolePermissionChanges SalonRolePermission[] @relation("RolePermissionUpdater")
}

model Session {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  salonId     String?
  salon       Salon?   @relation(fields: [salonId], references: [id], onDelete: SetNull)
  mfaVerified Boolean  @default(false)
  ip          String?
  userAgent   String?
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Salon {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  email          String
  phone          String
  address        String?
  timezone       String           @default("UTC")
  currency       String           @default("INR")
  locale         String           @default("en-IN")
  status         SalonStatus      @default(ACTIVE)
  ownerId        String
  owner          User             @relation("SalonOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  logoFileId     String?          @unique
  logoFile       FileAsset?       @relation("SalonLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  settings       Json             @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  branches       Branch[]
  memberships    Membership[]
  customers      Customer[]
  services       Service[]
  serviceCategories ServiceCategory[]
  taxRates       TaxRate[]
  appointments   Appointment[]
  queueTickets   QueueTicket[]
  invoices       Invoice[]
  expenses       Expense[]
  products       Product[]
  suppliers      Supplier[]
  stockMovements StockMovement[]
  purchases      Purchase[]
  plans          Subscription?
  files          FileAsset[]      @relation("SalonFiles")
  invitations    Invitation[]
  templates      NotificationTemplate[]
  notifications  NotificationLog[]
  auditLogs      AuditLog[]
  sessions       Session[]
  rolePermissions SalonRolePermission[]
  attendanceRecords AttendanceRecord[]
  leaveRequests  LeaveRequest[]
  salaryAdvances SalaryAdvance[]
  salaryPayments SalaryPayment[]
  employeeDocuments EmployeeDocument[]
  customerNotes  CustomerNote[]
  customerFollowUps CustomerFollowUp[]
}

model Branch {
  id           String   @id @default(cuid())
  salonId      String
  salon        Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  address      String?
  isPrimary    Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memberships  Membership[]
  appointments Appointment[]
  queueTickets QueueTicket[]
  invoices     Invoice[]
  expenses     Expense[]

  @@index([salonId])
}

model Membership {
  id                  String       @id @default(cuid())
  salonId             String
  salon               Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role                Role         @default(STAFF)
  permissionOverrides Json         @default("{}")
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  staffProfile        StaffProfile?
  appointments        Appointment[]
  queueTickets        QueueTicket[]
  invoiceLines        InvoiceLine[]
  attendanceRecords   AttendanceRecord[]
  leaveRequests       LeaveRequest[]
  salaryAdvances      SalaryAdvance[]
  salaryPayments      SalaryPayment[]
  employeeDocuments   EmployeeDocument[]
  followUpsAssigned   CustomerFollowUp[] @relation("FollowUpAssignee")
  preferredByCustomers Customer[] @relation("PreferredStaff")

  @@unique([salonId, userId])
  @@index([salonId, role])
}

model StaffProfile {
  id                    String     @id @default(cuid())
  membershipId          String     @unique
  membership            Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  bio                   String?
  specialties           String[]   @default([])
  color                 String     @default("#8c6a52")
  commissionRate        Decimal    @default(0) @db.Decimal(5, 2)
  schedule              Json       @default("[]")
  jobTitle              String?
  employmentType        String     @default("FULL_TIME")
  hiredAt               DateTime?
  monthlySalary         Decimal?   @db.Decimal(12, 2)
  payDay                Int        @default(1)
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  aadhaarNumber         String?
  panNumber             String?
  onboardingComplete    Boolean    @default(false)
}

model Invitation {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  email       String
  role        Role
  branchId    String?
  commissionRate Decimal @default(0) @db.Decimal(5, 2)
  tokenHash   String   @unique
  invitedById String
  invitedBy   User     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([salonId, email])
}

model Customer {
  id             String   @id @default(cuid())
  salonId        String
  salon          Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String   @default("")
  phone          String
  email          String?
  notes          String?
  preferences    String?
  tags           String[] @default([])
  birthday       DateTime? @db.Date
  anniversary    DateTime? @db.Date
  preferredStaffMembershipId String?
  preferredStaff Membership? @relation("PreferredStaff", fields: [preferredStaffMembershipId], references: [id], onDelete: SetNull)
  marketingOptIn Boolean  @default(false)
  source         String?
  lastVisitAt    DateTime?
  nextFollowUpAt DateTime?
  loyaltyPoints  Int      @default(0)
  totalVisits    Int      @default(0)
  totalSpent     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  appointments   Appointment[]
  invoices       Invoice[]
  queueTickets   QueueTicket[]
  notesTimeline  CustomerNote[]
  followUps      CustomerFollowUp[]

  @@unique([salonId, phone])
  @@index([salonId, lastName])
  @@index([salonId, email])
  @@index([salonId, nextFollowUpAt])
}

model ServiceCategory {
  id       String    @id @default(cuid())
  salonId  String
  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name     String
  services Service[]

  @@unique([salonId, name])
}

model TaxRate {
  id       String    @id @default(cuid())
  salonId  String
  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name     String
  rate     Decimal   @db.Decimal(5, 2)
  active   Boolean   @default(true)
  services Service[]
  products Product[]

  @@unique([salonId, name])
}

model Service {
  id             String          @id @default(cuid())
  salonId        String
  salon          Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxRateId      String?
  taxRate        TaxRate?        @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  price          Decimal         @db.Decimal(12, 2)
  durationMin    Int
  commissionRate Decimal?        @db.Decimal(5, 2)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]
  invoiceLines   InvoiceLine[]
  queueTickets   QueueTicket[]
  productUsage   ServiceProduct[]

  @@index([salonId, active])
}

model ServiceProduct {
  serviceId String
  productId String
  quantity  Int      @default(1)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([serviceId, productId])
}

model Product {
  id             String          @id @default(cuid())
  salonId        String
  salon          Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  taxRateId      String?
  taxRate        TaxRate?        @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  sku            String
  name           String
  description    String?
  price          Decimal         @db.Decimal(12, 2)
  cost           Decimal         @default(0) @db.Decimal(12, 2)
  stockQty       Int             @default(0)
  reorderLevel   Int             @default(0)
  unit           String          @default("unit")
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  serviceUsage   ServiceProduct[]
  invoiceLines   InvoiceLine[]

  @@unique([salonId, sku])
  @@index([salonId, active])
}

model Supplier {
  id        String     @id @default(cuid())
  salonId   String
  salon     Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  purchases Purchase[]

  @@index([salonId])
}

model StockMovement {
  id              String           @id @default(cuid())
  salonId         String
  salon           Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  productId       String
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type            StockMovementType
  quantity        Int
  resultingBalance Int
  unitCost        Decimal?         @db.Decimal(12, 2)
  reference       String?
  notes           String?
  createdById     String?
  createdBy       User?            @relation("StockActor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  @@index([salonId, productId, createdAt])
}

model Purchase {
  id          String         @id @default(cuid())
  salonId     String
  salon       Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  supplierId  String?
  supplier    Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  reference   String?
  total       Decimal        @db.Decimal(12, 2)
  notes       String?
  purchasedAt DateTime       @default(now())
  createdById String?
  createdBy   User?          @relation("PurchaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items       PurchaseItem[]

  @@index([salonId, purchasedAt])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  lineTotal  Decimal  @db.Decimal(12, 2)
}

model Appointment {
  id               String            @id @default(cuid())
  salonId          String
  salon            Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staffMembershipId String
  staff            Membership        @relation(fields: [staffMembershipId], references: [id], onDelete: Restrict)
  serviceId        String
  service          Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  startAt          DateTime
  endAt            DateTime
  status           AppointmentStatus @default(SCHEDULED)
  notes            String?
  walkIn           Boolean           @default(false)
  checkedInAt      DateTime?
  completedAt      DateTime?
  createdById      String?
  createdBy        User?             @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  invoices         Invoice[]

  @@index([salonId, startAt])
  @@index([salonId, staffMembershipId, startAt])
  @@index([salonId, branchId, status])
}

model QueueTicket {
  id               String      @id @default(cuid())
  salonId          String
  salon            Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId       String?
  customer         Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  serviceId        String?
  service          Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staffMembershipId String?
  staff            Membership? @relation(fields: [staffMembershipId], references: [id], onDelete: SetNull)
  name             String
  phone            String?
  queueNumber      Int
  status           QueueStatus @default(WAITING)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([salonId, branchId, status, createdAt])
}

model Invoice {
  id              String        @id @default(cuid())
  salonId         String
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appointmentId   String?
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  number          String
  status          InvoiceStatus @default(DRAFT)
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  amountRefunded  Decimal       @default(0) @db.Decimal(12, 2)
  commissionTotal Decimal       @default(0) @db.Decimal(12, 2)
  notes           String?
  issuedAt        DateTime?
  dueAt           DateTime?
  loyaltyAwardedAt DateTime?
  idempotencyKey  String?
  createdById     String?
  createdBy       User?         @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  pdfFileId       String?       @unique
  pdfFile         FileAsset?    @relation("InvoicePdf", fields: [pdfFileId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           InvoiceLine[]
  payments        Payment[]

  @@unique([salonId, number])
  @@unique([salonId, idempotencyKey])
  @@index([salonId, createdAt])
  @@index([salonId, status])
  @@index([salonId, customerId])
}

model InvoiceLine {
  id               String       @id @default(cuid())
  invoiceId        String
  invoice          Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind             String
  description      String
  quantity         Decimal      @db.Decimal(10, 3)
  unitPrice        Decimal      @db.Decimal(12, 2)
  taxRate          Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount        Decimal      @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal      @default(0) @db.Decimal(12, 2)
  lineTotal        Decimal      @db.Decimal(12, 2)
  serviceId        String?
  service          Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  productId        String?
  product          Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  staffMembershipId String?
  staff            Membership?  @relation(fields: [staffMembershipId], references: [id], onDelete: SetNull)
  commissionAmount Decimal      @default(0) @db.Decimal(12, 2)
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  kind        PaymentKind   @default(PAYMENT)
  reference   String?
  notes       String?
  receivedById String?
  receivedBy  User?         @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([invoiceId, createdAt])
}

model Expense {
  id          String        @id @default(cuid())
  salonId     String
  salon       Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category    String
  vendor      String?
  amount      Decimal       @db.Decimal(12, 2)
  spentAt     DateTime
  notes       String?
  status      ExpenseStatus @default(RECORDED)
  receiptFileId String?     @unique
  receiptFile FileAsset?    @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?         @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([salonId, spentAt])
}

model FileAsset {
  id           String   @id @default(cuid())
  salonId      String?
  salon        Salon?   @relation("SalonFiles", fields: [salonId], references: [id], onDelete: Cascade)
  kind         FileKind
  originalName String
  storedName   String
  relativePath String   @unique
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  logoForSalon Salon?  @relation("SalonLogo")
  expenseReceipt Expense?
  invoicePdf   Invoice? @relation("InvoicePdf")
  employeeDocument EmployeeDocument?

  @@index([salonId, kind])
}

model Plan {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String?
  monthlyPrice Decimal        @db.Decimal(12, 2)
  yearlyPrice  Decimal?       @db.Decimal(12, 2)
  features     Json           @default("[]")
  limits       Json           @default("{}")
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  salonId          String             @unique
  salon            Salon              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([planId])
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  scope     String              @default("global")
  salonId   String?
  salon     Salon?              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  key       String
  channel   NotificationChannel
  subject   String?
  body      String
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt
  createdAt DateTime            @default(now())
  logs      NotificationLog[]

  @@unique([scope, key, channel])
  @@index([salonId])
}

model NotificationLog {
  id          String              @id @default(cuid())
  salonId     String?
  salon       Salon?              @relation(fields: [salonId], references: [id], onDelete: SetNull)
  templateId  String?
  template    NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  channel     NotificationChannel
  templateKey String
  recipient   String
  status      NotificationStatus  @default(QUEUED)
  providerRef String?
  error       String?
  payload     Json?
  createdById String?
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())

  @@index([salonId, createdAt])
  @@index([status])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  salonId     String?
  salon       Salon?   @relation(fields: [salonId], references: [id], onDelete: SetNull)
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now())

  @@index([salonId, createdAt])
  @@index([actorUserId, createdAt])
}

model SalonRolePermission {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  role        Role
  permissions String[] @default([])
  updatedById String?
  updatedBy   User?    @relation("RolePermissionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([salonId, role])
  @@index([salonId])
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  salonId      String
  salon        Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  checkInAt    DateTime?
  checkOutAt   DateTime?
  workedMinutes Int?
  notes        String?
  markedById   String?
  markedBy     User?            @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([membershipId, date])
  @@index([salonId, date])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  salonId      String
  salon        Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  type         LeaveType   @default(CASUAL)
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  reason       String
  status       LeaveStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?       @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([salonId, status, startDate])
  @@index([membershipId, startDate])
}

model SalaryAdvance {
  id           String        @id @default(cuid())
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(12, 2)
  reason       String?
  requestedAt  DateTime      @default(now())
  status       AdvanceStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?         @relation("AdvanceDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  paidAt       DateTime?
  notes        String?
  createdById  String?
  createdBy    User?         @relation("AdvanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([salonId, status, requestedAt])
  @@index([membershipId, status])
}

model SalaryPayment {
  id              String        @id @default(cuid())
  salonId         String
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  membershipId    String
  membership      Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  periodStart     DateTime      @db.Date
  periodEnd       DateTime      @db.Date
  baseAmount      Decimal       @db.Decimal(12, 2)
  bonus           Decimal       @default(0) @db.Decimal(12, 2)
  deductions      Decimal       @default(0) @db.Decimal(12, 2)
  advanceDeduction Decimal      @default(0) @db.Decimal(12, 2)
  netAmount       Decimal       @db.Decimal(12, 2)
  method          PaymentMethod @default(CASH)
  status          PayrollStatus @default(PAID)
  paidAt          DateTime      @default(now())
  notes           String?
  createdById     String?
  createdBy       User?         @relation("SalaryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([membershipId, periodStart, periodEnd])
  @@index([salonId, paidAt])
}

model EmployeeDocument {
  id           String               @id @default(cuid())
  salonId      String
  salon        Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  kind         EmployeeDocumentKind @default(OTHER)
  title        String
  fileId       String               @unique
  file         FileAsset            @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?                @relation("EmployeeDocUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())

  @@index([salonId, membershipId])
}

model CustomerNote {
  id           String   @id @default(cuid())
  salonId      String
  salon        Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  body         String
  createdById  String?
  createdBy    User?    @relation("CustomerNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([salonId, customerId, createdAt])
}

model CustomerFollowUp {
  id                     String         @id @default(cuid())
  salonId                String
  salon                  Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerId             String
  customer               Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title                  String
  notes                  String?
  dueAt                  DateTime
  status                 FollowUpStatus @default(OPEN)
  assignedToMembershipId String?
  assignedTo             Membership?    @relation("FollowUpAssignee", fields: [assignedToMembershipId], references: [id], onDelete: SetNull)
  createdById            String?
  createdBy              User?          @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([salonId, status, dueAt])
  @@index([customerId, dueAt])
}

model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
