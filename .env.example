NODE_ENV=production
APP_URL=https://salon.example.com
DATABASE_URL=postgresql://salon:REPLACE_DB_PASSWORD@db:5432/salon_saas?schema=public
DB_PASSWORD=REPLACE_DB_PASSWORD
APP_SECRET=GENERATE_WITH_openssl_rand_base64_32
MFA_ENCRYPTION_KEY=GENERATE_ANOTHER_32_BYTE_BASE64_KEY
MAX_UPLOAD_MB=5
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
TRIAL_DAYS=14
LOG_LEVEL=info
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Email (needed for "Forgot password" emails). See SETUP_GUIDE.md.
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=yourname@gmail.com  SMTP_PASS=<16-letter Google App Password>
# Brevo (free 300 emails/day): SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your Company <yourname@gmail.com>"

# Online payments with Razorpay (free to set up; they charge a small fee per payment)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional SMS/WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
