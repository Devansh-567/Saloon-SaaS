{
  "name": "salon-saas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-super-admin.ts",
    "admin:reset-password": "tsx scripts/reset-password.ts",
    "setup": "node scripts/init-env.mjs",
    "backup": "node scripts/backup.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "dotenv": "^18.0.8",
    "next": "^16.4.2",
    "nodemailer": "10.1.7",
    "otplib": "13.5.0",
    "pdfkit": "0.20.2",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "7.0.4",
    "@types/pdfkit": "0.17.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
