NODE_ENV=production
APP_URL=https://salon.example.com
DATABASE_URL=postgresql://salon:REPLACE_DB_PASSWORD@db:5432/salon_saas?schema=public
DB_PASSWORD=REPLACE_DB_PASSWORD
APP_SECRET=GENERATE_WITH_openssl_rand_base64_32
MFA_ENCRYPTION_KEY=GENERATE_ANOTHER_32_BYTE_BASE64_KEY
STORAGE_ROOT=/data/storage
MAX_UPLOAD_MB=5
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
TRIAL_DAYS=14
LOG_LEVEL=info
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Optional email delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Salon SaaS <no-reply@example.com>"
# Optional SMS/WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
